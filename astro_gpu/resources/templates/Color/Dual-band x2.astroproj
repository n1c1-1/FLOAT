   "b49": {
    "engine": null,
    "files": null,
    "fork": null,
    "id": "b49",
    "kind": "combine",
    "method": null,
    "name": null,
    "off": false,
    "own": null,
    "params": {
     "combine_sho": {
      "hue_ha": 31.4,
      "hue_oiii": 202.2,
      "hue_sii": 15.5
     }
    },
    "pause": false,
    "settings": {},
    "sid": null,
    "source": {
     "recipe": {
      "description": "Combines the S II, H-alpha and O III filters into one colour image: the S II and the O III equalised to the H-alpha, then each filter a hue.",
      "id": "sho",
      "inputs": [
       {
        "channel": "L",
        "label": "S II",
        "role": "SII",
        "type": "any"
       },
       {
        "channel": "L",
        "label": "Hα",
        "role": "Ha",
        "type": "any"
       },
       {
        "channel": "L",
        "label": "O III",
        "role": "OIII",
        "type": "any"
       }
      ],
      "name": "S-H-O",
      "narrowband": true,
      "output": {
       "channels": [
        "SII",
        "Ha",
        "OIII"
       ],
       "hues": [
        "$hue_sii",
        "$hue_ha",
        "$hue_oiii"
       ],
       "lightness": null,
       "matrix": null,
       "radius": null,
       "saturation": [],
       "smoothing": null,
       "strength": 1.0,
       "weighting": null
      },
      "parameters": {
       "hue_ha": {
        "default": 31.4,
        "help": "The colour of the H-alpha filter (0 red, 120 green, 240 blue).",
        "label": "Hα hue",
        "max": 360.0,
        "min": 0.0
       },
       "hue_oiii": {
        "default": 202.2,
        "help": "The colour of the O III filter (0 red, 120 green, 240 blue).",
        "label": "O III hue",
        "max": 360.0,
        "min": 0.0
       },
       "hue_sii": {
        "default": 15.5,
        "help": "The colour of the S II filter (on the colour wheel: 0 red, 120 green, 240 blue).",
        "label": "S II hue",
        "max": 360.0,
        "min": 0.0
       }
      },
      "steps": [
       {
        "op": "neutralise_sky"
       },
       {
        "channels": [],
        "op": "equalise",
        "reference": "Ha"
       }
      ],
      "version": 2
     }
    }
   },
